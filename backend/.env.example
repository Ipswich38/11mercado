# AI Orchestrator Environment Configuration
# Copy this file to .env and configure with your actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000
API_VERSION=1.0.0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=your-super-secure-jwt-secret-change-in-production
ENCRYPTION_KEY=your-32-character-encryption-key-here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL for structured data
DATABASE_URL=postgresql://username:password@localhost:5432/ai_orchestrator
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_orchestrator
DB_USER=ai_user
DB_PASSWORD=secure_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis for caching and session storage
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
# Groq API (current implementation)
GROQ_API_KEY=your-groq-api-key-here

# OpenAI (alternative/backup)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORG_ID=your-org-id

# Hugging Face (for specialized models)
HUGGINGFACE_API_KEY=your-hf-api-key-here

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=your-claude-api-key-here

# =============================================================================
# MODEL SERVING CONFIGURATION
# =============================================================================
MODEL_REGISTRY_URL=http://localhost:8080
MODEL_SERVER_URL=http://localhost:8081
DEFAULT_MODEL_ID=mental_health_counselor_v2
FALLBACK_MODEL_ID=safe_fallback_v1
MODEL_CACHE_TTL=3600
MAX_MODEL_REPLICAS=3

# =============================================================================
# VECTOR DATABASE CONFIGURATION
# =============================================================================
# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp-free
PINECONE_INDEX_NAME=ai-orchestrator

# Alternative: Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-key

# Alternative: Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# =============================================================================
# FEATURE STORE CONFIGURATION
# =============================================================================
FEATURE_STORE_URL=redis://localhost:6379/1
FEATURE_COMPUTATION_BATCH_SIZE=1000
FEATURE_RETENTION_DAYS=90
ENABLE_FEATURE_DRIFT_DETECTION=true

# =============================================================================
# SAFETY & MODERATION CONFIGURATION
# =============================================================================
SAFETY_THRESHOLD_TOXICITY=0.7
SAFETY_THRESHOLD_SELF_HARM=0.5
SAFETY_THRESHOLD_SUICIDAL=0.3
ENABLE_HUMAN_REVIEW=true
HUMAN_REVIEW_WEBHOOK_URL=https://your-domain.com/webhooks/human-review
CRISIS_ALERT_WEBHOOK_URL=https://your-domain.com/webhooks/crisis-alert

# Content moderation service
PERSPECTIVE_API_KEY=your-perspective-api-key

# =============================================================================
# MLOPS CONFIGURATION
# =============================================================================
TRAINING_DATA_BUCKET=s3://your-training-data-bucket
MODEL_ARTIFACTS_BUCKET=s3://your-model-artifacts-bucket
EXPERIMENT_TRACKING_URL=http://localhost:5000
ENABLE_AUTO_RETRAINING=true
RETRAINING_THRESHOLD_ACCURACY=0.85
EVALUATION_SCHEDULE=0 2 * * 0

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ai-orchestrator

# Weights & Biases
WANDB_API_KEY=your-wandb-api-key
WANDB_PROJECT=ai-orchestrator
WANDB_ENTITY=your-team

# =============================================================================
# OBSERVABILITY & MONITORING
# =============================================================================
# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/app.log
ENABLE_REQUEST_LOGGING=true

# Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_PREFIX=ai_orchestrator

# Tracing
JAEGER_ENDPOINT=http://localhost:14268/api/traces
ENABLE_TRACING=false

# Application Performance Monitoring
SENTRY_DSN=your-sentry-dsn
NEWRELIC_LICENSE_KEY=your-newrelic-key

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL_FROM=noreply@your-domain.com
ADMIN_EMAIL=admin@your-domain.com

# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
SLACK_CHANNEL=#ai-orchestrator-alerts

# SMS notifications (for crisis situations)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Kubernetes
K8S_NAMESPACE=ai-orchestrator
K8S_CONFIG_PATH=/path/to/kubeconfig

# Docker
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_TAG=latest

# Health checks
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
STARTUP_TIMEOUT=120000

# Resource limits
MAX_MEMORY_MB=2048
MAX_CPU_CORES=4
MAX_GPU_MEMORY_GB=8

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# Test database
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/ai_orchestrator_test

# Mock services in development
MOCK_EXTERNAL_APIS=false
MOCK_MODEL_INFERENCE=false
MOCK_SAFETY_CHECKS=false

# Development features
ENABLE_SWAGGER_UI=true
ENABLE_DEBUG_ROUTES=false
ENABLE_PLAYGROUND=true
CORS_CREDENTIALS=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_FLAG_NEW_ROUTING_ALGORITHM=false
FEATURE_FLAG_ADVANCED_SAFETY_CHECKS=true
FEATURE_FLAG_EXPERIMENTAL_MODELS=false
FEATURE_FLAG_MULTI_LANGUAGE_SUPPORT=false
FEATURE_FLAG_VOICE_PROCESSING=false

# =============================================================================
# CRISIS INTERVENTION SETTINGS
# =============================================================================
# Emergency contact configuration
CRISIS_HOTLINE_US=988
CRISIS_HOTLINE_PH=1553
CRISIS_TEXT_LINE=741741
EMERGENCY_SERVICES=911

# Crisis response settings
CRISIS_RESPONSE_TIMEOUT_MS=5000
ENABLE_AUTOMATED_CRISIS_RESPONSE=true
CRISIS_ESCALATION_WEBHOOK=https://your-domain.com/crisis-escalation
REQUIRE_HUMAN_CONFIRMATION_FOR_CRISIS=true

# Follow-up settings
ENABLE_CRISIS_FOLLOWUP=true
FOLLOWUP_SCHEDULE_HOURS=24,72,168
FOLLOWUP_MAX_ATTEMPTS=3